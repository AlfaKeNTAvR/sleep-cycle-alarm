    <string name="debug_fast_night_title">Fast night</string>
    <string name="debug_fast_night_description">Runs the engine on a shortened schedule: 3 min cycles, so a whole night finishes in minutes.</string>
    <string name="debug_dry_run_title">Dry run band commands</string>
    <string name="debug_dry_run_description">Logs band alarm commands instead of sending them; confirms them after one tick so the flow continues.</string>
    <string name="debug_simulator_controls_title">Simulator</string>
