    <string name="setup_wizard_band_address_body">The band\'s Bluetooth MAC address, prefilled with the owner\'s band. Change it only if you are pairing a different one.</string>

    <string name="setup_wizard_gadgetbridge_intents_title">Gadgetbridge: Intent API</string>
    <string name="setup_wizard_gadgetbridge_intents_body">In Gadgetbridge, under Developer options, turn these four on:</string>
    <string-array name="setup_wizard_gadgetbridge_intents_lines">
        <item>Allow activity sync trigger</item>
        <item>Broadcast on activity sync finish</item>
        <item>Allow database export trigger</item>
        <item>Broadcast on export</item>
    </string-array>

    <string name="setup_wizard_gadgetbridge_auto_export_title">Gadgetbridge: auto export</string>
    <string name="setup_wizard_gadgetbridge_auto_export_body">Still in Gadgetbridge, under Automations › Auto export database:</string>
    <string name="setup_wizard_gadgetbridge_auto_export_enable_line">Turn on \"Auto export enabled\"</string>
    <string name="setup_wizard_gadgetbridge_auto_export_location_line">Set \"Export location\" to a folder such as Documents - required, or exports write nothing</string>
    <string name="setup_wizard_gadgetbridge_auto_export_warning">Do NOT use Data management › Export Data - that folder belongs to Gadgetbridge and our app cannot read it.</string>

    <string name="setup_wizard_export_file_title">Export file</string>

    <string name="setup_wizard_phone_permissions_title">Phone permissions</string>

    <string name="setup_wizard_band_alarms_title">Band alarms</string>
    <string name="setup_wizard_band_alarms_allow_third_party_line">Band gear › Developer options: \"Allow 3rd party apps to set alarms\"</string>
    <string name="setup_wizard_band_alarms_smart_slot_note">One of the band\'s alarm slots may be a fixed smart-wakeup slot that can never become a normal alarm. If Test connection flags one, give it a title (for example \"Smart\") and leave it switched off.</string>
    <string name="setup_wizard_band_alarms_free_slot_note">If Test connection reports too few free slots, open the band\'s alarms in Gadgetbridge and clear the title of a disabled one.</string>

    <string name="setup_wizard_test_connection_title">Test connection</string>
