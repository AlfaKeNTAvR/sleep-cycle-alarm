    <string name="alarm_instruction_wake">Wake up</string>
    <!-- N1 (owner decision, 2026-09-21): Stop is the ONLY action a ring offers. It used to also offer "I'm
         awake", which ended the night outright; a mis-tap on a lock screen at 03:00 therefore silenced every
         alarm left in the night, which is the one failure this app exists to prevent. Ending a night now
         needs the night screen's own button, which is deliberately harder to reach half asleep. -->
    <string name="alarm_action_stop">Stop</string>
