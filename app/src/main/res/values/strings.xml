    <!-- Before bed: no-deadline note -->
    <string name="before_bed_no_deadline_note">Without a deadline the wake time keeps moving until the band reports sleep, so nothing caps the night.</string>

    <!-- Item 4: no phone alarm at all tonight (deadline off AND phone backup off) -->
    <string name="warning_no_phone_alarm">Nothing on the phone will ring tonight, only the band.</string>

    <!-- Band alarm protocol in use tonight, decided from the band's own alarm table (BandAlarmSlotMode.kt) -->
    <string name="night_band_alarm_mode_two_slots">Band alarm mode: two slots, no gap when the time moves</string>
    <string name="night_band_alarm_mode_single_slot">Band alarm mode: one slot</string>
    <string name="night_band_alarm_mode_blind">Band alarm mode: no alarm table yet, holding the last alarm</string>

    <!-- Single-slot mode: the band has no alarm between the clear and the re-set on every move. Which line
         shows depends on whether a phone alarm exists at all tonight - claiming a safety net that is switched
         off is exactly what contradicted warning_no_phone_alarm on the same screen. -->
    <string name="warning_band_single_slot">Only one band alarm slot: the band alarm is briefly cleared each time the wake time moves. The phone alarm is the safety net.</string>
    <string name="warning_band_single_slot_no_phone_alarm">Only one band alarm slot: the band alarm is briefly cleared each time the wake time moves, and nothing on the phone will ring if it does not come back.</string>

    <!-- Single-slot mode: tonight's bounded re-sends are all spent, so the app stopped trying to restore the band alarm -->
    <string name="warning_band_resend_limit_reached">The band alarm could not be set again tonight; the app has stopped retrying. Check your band, or rely on the phone alarm.</string>

    <!-- Smart-wakeup: the slot backing our confirmed or requested band alarm still carries the band's own smart-wakeup flag -->
    <string name="warning_band_smart_wakeup">Band may wake you up to %1$d min early: slot %2$d is a smart alarm</string>
    <string name="warning_band_smart_wakeup_unknown_window">Band may wake you up early: slot %1$d is a smart alarm</string>

