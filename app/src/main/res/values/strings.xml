    <!-- Setup screen -->
    <string name="setup_title">Setup</string>
    <string name="setup_subtitle">Complete every item before your first night.</string>
    <string name="setup_item_gadgetbridge_installed_label">Gadgetbridge installed</string>
    <string name="setup_item_gadgetbridge_installed_detail">Gadgetbridge must be installed on this phone.</string>
    <string name="setup_item_band_address_label">Band address set</string>
    <string name="setup_item_band_address_detail">The band\'s Bluetooth MAC address.</string>
    <string name="setup_item_export_file_label">Export file picked</string>
    <string name="setup_item_export_file_detail">The file Gadgetbridge auto-exports its database to.</string>
    <string name="setup_item_notifications_label">Notifications allowed</string>
    <string name="setup_item_notifications_detail">Needed for the tracking notice and the alarm.</string>
    <string name="setup_item_full_screen_intent_label">Full-screen alarms allowed</string>
    <string name="setup_item_full_screen_intent_detail">So the alarm screen can wake the phone over the lock screen.</string>
    <string name="setup_item_battery_optimization_label">Battery optimisation off for this app</string>
    <string name="setup_item_battery_optimization_detail">So Android does not delay overnight syncs.</string>
    <string name="setup_item_exact_alarms_label">Exact alarms allowed</string>
    <string name="setup_item_exact_alarms_detail">So the wake-up alarm fires on time.</string>
    <string name="setup_device_mac_label">Band Bluetooth address</string>
    <string name="setup_pick_export_file">Pick export file</string>
    <string name="setup_pick_export_file_helper">Pick the same file you set as the export location below, in Gadgetbridge\'s Automations › Auto export database screen.</string>
    <string name="setup_gadgetbridge_settings_title">Gadgetbridge settings to switch on</string>
    <string-array name="setup_gadgetbridge_settings">
        <item>Developer options › Intent API: \"Allow activity sync trigger\"</item>
        <item>Developer options › Intent API: \"Broadcast on activity sync finish\"</item>
        <item>Developer options › Intent API: \"Allow database export trigger\"</item>
        <item>Developer options › Intent API: \"Broadcast on export\"</item>
        <item>Automations › Auto export database: turn on \"Auto export enabled\"</item>
        <item>Same screen, \"Export location\": set it (e.g. to Documents) - required, or exports write nothing</item>
        <item>Do NOT use Data management › Export Data - that folder belongs to Gadgetbridge and our app cannot read it</item>
        <item>Band gear › Developer options: \"Allow 3rd party apps to set alarms\"</item>
    </string-array>
