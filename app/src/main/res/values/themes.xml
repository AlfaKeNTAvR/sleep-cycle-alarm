<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme is dark regardless of system setting: this is a night-time app. -->
    <!-- No android:statusBarColor / android:navigationBarColor here: MainActivity.enableEdgeToEdge() owns
         the system bars at runtime (transparent, forced-dark icon style) - a theme color would fight it. -->
    <style name="Theme.SleepCycleAlarm" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_background</item>
    </style>
</resources>
