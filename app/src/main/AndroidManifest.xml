<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Band data sync and alarms -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Explicit broadcasts only, but Android still requires a visibility declaration to query Gadgetbridge. -->
    <queries>
        <package android:name="nodomain.freeyourgadget.gadgetbridge" />
    </queries>

    <application
        android:name=".SleepCycleApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.SleepCycleAlarm">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.SleepCycleAlarm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".alarm.AlarmActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:theme="@style/Theme.SleepCycleAlarm" />

        <service
            android:name=".night.NightService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Overnight sleep tracking bridge that moves a wake-up alarm" />
        </service>

        <service
            android:name=".alarm.AlarmRingService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Rings the wake-up alarm this app scheduled" />
        </service>

        <!-- H7.3: the silent pre-nudge re-sync check, a background job that can take as long as a real band
             sync - too long to risk inside a plain BroadcastReceiver, hence its own foreground service. -->
        <service
            android:name=".night.OutOfBedPreNudgeCheckService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Checks whether the owner is still asleep before the out-of-bed alarm" />
        </service>

        <receiver android:name=".night.TickReceiver" android:exported="false" />

        <receiver android:name=".night.OutOfBedPreNudgeCheckReceiver" android:exported="false" />

        <receiver
            android:name=".night.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- F13: Android cancels every alarm this app has set when its own package is replaced - an
                     update mid-night would otherwise silently drop the wake alarm, the nudge and the tick
                     alarm with nothing left to re-arm them. Delivered without a data/scheme filter, matching
                     only this app's own package, so no <data> element is needed here. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>

        <receiver android:name=".alarm.PhoneAlarmReceiver" android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
